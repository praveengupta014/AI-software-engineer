# ./setup.sh creates POSTGRES_PASSWORD and COUNTERSIGN_AUDIT_KEY for you. Everything else here is
# optional: Claude and GitHub are connected in the browser.

# POSTGRES_PASSWORD=
# COUNTERSIGN_AUDIT_KEY=

# Set these to keep secrets in your own manager instead of the app's data volume.
# ANTHROPIC_API_KEY=
# COUNTERSIGN_GITHUB_APP_ID=
# COUNTERSIGN_GITHUB_APP_PRIVATE_KEY=
# COUNTERSIGN_GITHUB_WEBHOOK_SECRET=

# COUNTERSIGN_PUBLIC_URL=
# COUNTERSIGN_SLACK_WEBHOOK_URL=
# COUNTERSIGN_TEAMS_WEBHOOK_URL=
# COUNTERSIGN_JIRA_WEBHOOK_SECRET=
# COUNTERSIGN_LINEAR_WEBHOOK_SECRET=

# Cost estimates only, USD per million tokens. Update these if you change the model.
# COUNTERSIGN_PRICE_INPUT_PER_MTOK=4.0
# COUNTERSIGN_PRICE_OUTPUT_PER_MTOK=20.0
# COUNTERSIGN_PRICE_CACHE_READ_PER_MTOK=0.20

# COUNTERSIGN_MODEL=claude-opus-5-5
# COUNTERSIGN_MAX_AGENT_TURNS=30
# COUNTERSIGN_WORKER_CONCURRENCY=4
