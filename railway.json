{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "preDeployCommand": "/srv/.venv/bin/python -m app.migrate",
    "startCommand": "/srv/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE"
  }
}

